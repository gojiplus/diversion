{
  "name": "Diversion",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {"openFiles": ["README.md", "app.py"]},
    "vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]}
  },
  "postCreateCommand": "pip install uv && uv sync --frozen --all-groups",
  "postAttachCommand": {"server": "uv run streamlit run app.py"},
  "portsAttributes": {"8501": {"label": "Diversion", "onAutoForward": "openPreview"}},
  "forwardPorts": [8501]
}
