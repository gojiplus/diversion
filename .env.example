# Server-side key: enable Google Routes API and Places API (New).
GOOGLE_MAPS_API_KEY=

# Optional public key: enable Maps JavaScript API and restrict HTTP referrers.
# Use a separate key; the server key is never used by the browser map.
GOOGLE_MAPS_BROWSER_API_KEY=

# Optional, used only after clicking Generate optional AI description.
OPENAI_API_KEY=
